.PHONY: clean All

All:
	@echo "==========Building project:[ FunctionsClass2nd - Debug ]=========="
	@cd "FunctionsClass2nd" && "$(MAKE)" -f  "FunctionsClass2nd.mk"
clean:
	@echo "==========Cleaning project:[ FunctionsClass2nd - Debug ]----------"
	@cd "FunctionsClass2nd" && "$(MAKE)" -f  "FunctionsClass2nd.mk" clean
