.PHONY: clean All

All:
	@echo "==========Building project:[ Section9ChallangeSolution - Debug ]=========="
	@cd "Section9ChallangeSolution" && "$(MAKE)" -f  "Section9ChallangeSolution.mk"
clean:
	@echo "==========Cleaning project:[ Section9ChallangeSolution - Debug ]----------"
	@cd "Section9ChallangeSolution" && "$(MAKE)" -f  "Section9ChallangeSolution.mk" clean
